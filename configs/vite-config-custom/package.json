{
  "name": "vite-config-custom",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "typings": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "prettier": "prettier-config-custom",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "yarn g:clean",
    "build": "yarn run -T tsc --build tsconfig.lib.json --emitDeclarationOnly false",
    "lint": "yarn g:lint",
    "fix": "yarn g:fix",
    "check": "yarn g:check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint-config-custom": "workspace:^",
    "prettier-config-custom": "workspace:^",
    "tsconfig-custom": "workspace:^",
    "vite-config-builder": "catalog:",
    "vite-plugin-dts-build": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
