{
  "name": "mincho-docs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "yarn demo:build && yarn i18n:compile && next dev",
    "build": "yarn demo:build && yarn i18n:check && next build && pagefind --site out --output-path out/_pagefind",
    "demo:build": "yarn run -T task build --filter=@mincho-js/css --filter=@mincho-js/esbuild && node scripts/build-demo.mjs",
    "start": "next start",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --strict",
    "i18n:check": "yarn i18n:extract && yarn i18n:compile",
    "check": "yarn i18n:compile && tsc --noEmit --project tsconfig.app.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "geist": "catalog:",
    "next": "catalog:",
    "nextra": "catalog:",
    "nextra-theme-docs": "patch:nextra-theme-docs@npm%3A4.6.1#~/.yarn/patches/nextra-theme-docs-npm-4.6.1-0b59bd8bbb.patch",
    "pretendard": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@lingui/cli": "catalog:",
    "@lingui/conf": "catalog:",
    "@mincho-js/css": "workspace:^",
    "@mincho-js/esbuild": "workspace:^",
    "@mincho-js/transform-to-vanilla": "workspace:^",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "esbuild": "catalog:",
    "next-rspack": "catalog:",
    "pagefind": "catalog:",
    "typescript": "catalog:"
  }
}
