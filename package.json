{
  "name": "mincho",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "configs/*",
    "packages/*",
    "examples/*",
    "site"
  ],
  "scripts": {
    "postinstall": "yarn workspace vite-config-custom build",
    "task": "yarn run -T turbo run --cache-dir .cache/turbo",
    "clean": "yarn g:clean & yarn task clean",
    "build": "yarn task build",
    "build:full": "PACKAGE_PUBLISH=true yarn task build",
    "build:type": "yarn workspace mincho-docs i18n:compile && yarn tsc --build",
    "lint": "yarn lint:action & yarn task lint",
    "lint:action": "yarn run -T eslint '.github/**/*.{js,yaml,yml}' --cache --cache-location .cache/eslint_action",
    "fix": "yarn fix:action && yarn task fix",
    "fix:action": "yarn lint:action --fix",
    "audit": "yarn npm audit --all --recursive --no-deprecations",
    "check": "yarn task check",
    "check:all": "yarn task check:all",
    "check:peers": "yarn explain peer-requirements | grep -q '\u2718' && exit 1 || exit 0",
    "check:package-contract": "yarn vite-node scripts/package-contract/index.ts",
    "check:vite-native-css-contract": "yarn workspace @mincho-js/vite test src/libraryCssFinalization.test.ts src/libraryCssConsumers.test.ts src/appCss.test.ts src/distChunkCss.test.ts --exclude '**/_release/**'",
    "benchmark:compilation": "node scripts/benchmark-compilation.mjs",
    "benchmark:runtime": "node scripts/benchmark-runtime.mjs",
    "benchmark:cx": "node scripts/benchmark-cx.mjs",
    "benchmark:css": "node scripts/benchmark-css.mjs",
    "check:pkgs": "yarn check:peers & yarn constraints",
    "doctor": "node scripts/doctor/index.mjs",
    "doctor:raw": "doctor",
    "sync": "workspaces-to-typescript-project-references --includesRoot --includesLocal",
    "sync:check": "yarn sync --check",
    "test": "yarn task test",
    "test:browser": "yarn workspaces foreach --all --parallel --jobs 2 --exclude mincho run test:browser",
    "test:browser:install": "playwright install --with-deps chromium",
    "test:all": "yarn task test:all",
    "test:doctor": "node --test scripts/doctor/*.test.mjs",
    "verify:production-contract": "yarn g:clean && yarn task clean && yarn build:release && yarn check:package-contract",
    "coverage": "yarn task coverage",
    "coverage:all": "yarn task coverage:all",
    "forallpackages": "yarn workspaces foreach -Aptv --no-private --verbose",
    "build:release": "PACKAGE_PUBLISH=true yarn task build --filter='./packages/*' --filter=@examples/shared-component && yarn forallpackages exec \"rimraf _release && yarn pack && mkdir _release && tar zxvf package.tgz --directory _release && rimraf package.tgz\"",
    "changeset:version": "yarn changeset version",
    "publish": "yarn build:release && yarn check:package-contract && yarn check:vite-native-css-contract && yarn changeset publish",
    "g:clean": "cd $INIT_CWD && yarn run -T rimraf .cache _release dist coverage .turbo tsconfig.tsbuildinfo node_modules/.vite",
    "g:build": "cd $INIT_CWD && yarn run -T vite build",
    "g:build-watch": "cd $INIT_CWD && yarn run build --watch",
    "g:codegen": "cd $INIT_CWD && yarn run -T vite-node --tsconfig ./tsconfig.codegen.json codegen/index.ts",
    "g:test": "cd $INIT_CWD && yarn run -T vitest run",
    "g:test-watch": "cd $INIT_CWD && yarn run -T vitest",
    "g:coverage": "yarn g:test --coverage",
    "g:lint": "cd $INIT_CWD && yarn run -T eslint . --cache --cache-location .cache/eslint --report-unused-disable-directives --max-warnings 0",
    "g:fix": "cd $INIT_CWD && yarn g:lint --fix",
    "g:check": "cd $INIT_CWD && yarn run -T tsc -b --noEmit",
    "g:check-trace": "cd $INIT_CWD && yarn run -T rimraf tsconfig.tsbuildinfo && yarn run -T tsc -p tsconfig.json --generateTrace traceDir && yarn run -T analyze-trace traceDir"
  },
  "prettier": "prettier-config-custom",
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@mincho-js/css": "workspace:^",
    "@mincho-js/debug-log": "workspace:^",
    "@monorepo-utils/workspaces-to-typescript-project-references": "catalog:",
    "@types/eslint": "catalog:",
    "@types/node": "catalog:",
    "@typescript/analyze-trace": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@yarnpkg/doctor": "patch:@yarnpkg/doctor@npm%3A4.0.7#~/.yarn/patches/@yarnpkg-doctor-npm-4.0.7-55eff097e1.patch",
    "@yarnpkg/types": "catalog:",
    "c8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-custom": "workspace:^",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-config-custom": "workspace:^",
    "rimraf": "catalog:",
    "terser": "catalog:",
    "tsconfig-custom": "workspace:^",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:",
    "vitest": "catalog:",
    "yarn-constraints-rules": "catalog:"
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "resolutions": {
    "@xmldom/xmldom": "^0.9.12",
    "node-gyp": "^11.5.0",
    "katex": "^0.19.1",
    "minimatch": "11.0.3",
    "glob": "14.0.3",
    "csstype": "patch:csstype@npm%3A3.2.3#~/.yarn/patches/csstype-npm-3.2.3-741053244e.patch"
  }
}
