{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mincho-js/babel",
  "description": "Babel configuration for Mincho.js",
  "version": "1.0.0",
  "sideEffects": false,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mincho-js/mincho.git",
    "directory": "packages/babel"
  },
  "keywords": [
    "babel"
  ],
  "bugs": {
    "url": "https://github.com/mincho-js/mincho/issues"
  },
  "homepage": "https://github.com/mincho-js/mincho/tree/main/packages/babel#readme",
  "typings": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "publishConfig": {
    "directory": "_release/package"
  },
  "files": [
    "dist",
    "src",
    "**/package.json"
  ],
  "scripts": {
    "clean": "yarn g:clean",
    "build": "yarn g:build",
    "build:watch": "yarn g:build-watch",
    "test": "yarn g:test",
    "test:watch": "yarn g:test-watch",
    "coverage": "yarn g:coverage",
    "lint": "yarn g:lint",
    "fix": "yarn g:fix",
    "check": "yarn g:check"
  },
  "prettier": "prettier-config-custom",
  "dependencies": {
    "@babel/core": "catalog:",
    "@babel/helper-module-imports": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/traverse": "catalog:",
    "@emotion/hash": "catalog:",
    "@mincho-js/css": "workspace:^",
    "@mincho-js/transform-runtime": "workspace:^",
    "@types/babel__core": "catalog:",
    "@types/babel__traverse": "catalog:"
  },
  "devDependencies": {
    "@mincho-js/debug-log": "workspace:^",
    "@types/babel__generator": "catalog:",
    "@types/node": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "esbuild": "catalog:",
    "eslint-config-custom": "workspace:^",
    "prettier-config-custom": "workspace:^",
    "tsconfig-custom": "workspace:^",
    "tslib": "catalog:",
    "vite": "catalog:",
    "vite-config-custom": "workspace:^",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@mincho-js/css": "workspace:^",
    "@vanilla-extract/css": "*"
  }
}
