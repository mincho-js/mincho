{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mincho-js/css",
  "description": " Natural CSS in the Typescript",
  "version": "0.2.2",
  "sideEffects": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mincho-js/mincho.git",
    "directory": "packages/css"
  },
  "keywords": [
    "css",
    "style",
    "typescript",
    "vanilla-extract",
    "preprocessor",
    "transform",
    "nested",
    "nested css",
    "css nesting",
    "css-in-js",
    "css-in-ts"
  ],
  "bugs": {
    "url": "https://github.com/mincho-js/mincho/issues"
  },
  "homepage": "https://github.com/mincho-js/mincho/tree/main/packages/css#readme",
  "typings": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./classname": {
      "import": {
        "types": "./dist/esm/classname/index.d.ts",
        "default": "./dist/esm/runtime/classname.mjs"
      },
      "require": {
        "types": "./dist/cjs/classname/index.d.cts",
        "default": "./dist/cjs/runtime/classname.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/esm/compat.d.ts",
        "default": "./dist/esm/compat.mjs"
      },
      "require": {
        "types": "./dist/cjs/compat.d.cts",
        "default": "./dist/cjs/compat.cjs"
      }
    },
    "./defineRules/createDefineRulesCssRuntime": {
      "import": {
        "types": "./dist/esm/defineRules/createDefineRulesCssRuntime.d.ts",
        "default": "./dist/esm/defineRules/createDefineRulesCssRuntime.mjs"
      },
      "require": {
        "types": "./dist/cjs/defineRules/createDefineRulesCssRuntime.d.cts",
        "default": "./dist/cjs/defineRules/createDefineRulesCssRuntime.cjs"
      }
    },
    "./defineRules/createDefineRulesCxRuntime": {
      "import": {
        "types": "./dist/esm/defineRules/createDefineRulesCxRuntime.d.ts",
        "default": "./dist/esm/runtime/createDefineRulesCxRuntime.mjs"
      },
      "require": {
        "types": "./dist/cjs/defineRules/createDefineRulesCxRuntime.d.cts",
        "default": "./dist/cjs/runtime/createDefineRulesCxRuntime.cjs"
      }
    },
    "./defineRules/registry": {
      "import": {
        "types": "./dist/esm/defineRules/registry.d.ts",
        "default": "./dist/esm/defineRules/registry.mjs"
      },
      "require": {
        "types": "./dist/cjs/defineRules/registry.d.cts",
        "default": "./dist/cjs/defineRules/registry.cjs"
      }
    },
    "./rules/createRuntimeFn": {
      "import": {
        "types": "./dist/esm/rules/createRuntimeFn.d.ts",
        "default": "./dist/esm/runtime/createRuntimeFn.mjs"
      },
      "require": {
        "types": "./dist/cjs/rules/createRuntimeFn.d.cts",
        "default": "./dist/cjs/runtime/createRuntimeFn.cjs"
      }
    },
    "./rules/createClassRuntimeFn": {
      "import": {
        "types": "./dist/esm/rules/createClassRuntimeFn.d.ts",
        "default": "./dist/esm/runtime/createClassRuntimeFn.mjs"
      },
      "require": {
        "types": "./dist/cjs/rules/createClassRuntimeFn.d.cts",
        "default": "./dist/cjs/runtime/createClassRuntimeFn.cjs"
      }
    },
    "./rules/mapVarProps": {
      "import": {
        "types": "./dist/esm/rules/mapVarProps.d.ts",
        "default": "./dist/esm/runtime/mapVarProps.mjs"
      },
      "require": {
        "types": "./dist/cjs/rules/mapVarProps.d.cts",
        "default": "./dist/cjs/runtime/mapVarProps.cjs"
      }
    },
    "./rules/createCompactRuntimeFn": {
      "import": {
        "types": "./dist/esm/rules/createCompactRuntimeFn.d.ts",
        "default": "./dist/esm/runtime/createCompactRuntimeFn.mjs"
      },
      "require": {
        "types": "./dist/cjs/rules/createCompactRuntimeFn.d.cts",
        "default": "./dist/cjs/runtime/createCompactRuntimeFn.cjs"
      }
    },
    "./rules/createPackedRuntimeFn": {
      "import": {
        "types": "./dist/esm/rules/createPackedRuntimeFn.d.ts",
        "default": "./dist/esm/runtime/createPackedRuntimeFn.mjs"
      },
      "require": {
        "types": "./dist/cjs/rules/createPackedRuntimeFn.d.cts",
        "default": "./dist/cjs/runtime/createPackedRuntimeFn.cjs"
      }
    },
    "./rules/createPackedCompactRuntimeFn": {
      "import": {
        "types": "./dist/esm/rules/createPackedCompactRuntimeFn.d.ts",
        "default": "./dist/esm/runtime/createPackedCompactRuntimeFn.mjs"
      },
      "require": {
        "types": "./dist/cjs/rules/createPackedCompactRuntimeFn.d.cts",
        "default": "./dist/cjs/runtime/createPackedCompactRuntimeFn.cjs"
      }
    },
    "./layout": {
      "import": {
        "types": "./dist/esm/layout/index.d.ts",
        "default": "./dist/esm/layout/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/layout/index.d.cts",
        "default": "./dist/cjs/layout/index.cjs"
      }
    },
    "./layout/core": {
      "import": {
        "types": "./dist/esm/layout/core.d.ts",
        "default": "./dist/esm/layout/core.mjs"
      },
      "require": {
        "types": "./dist/cjs/layout/core.d.cts",
        "default": "./dist/cjs/layout/core.cjs"
      }
    },
    "./layout.css": "./dist/esm/layout.css",
    "./squircle": {
      "import": {
        "types": "./dist/esm/squircle/index.d.ts",
        "default": "./dist/esm/squircle/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/squircle/index.d.cts",
        "default": "./dist/cjs/squircle/index.cjs"
      }
    },
    "./squircle/core": {
      "import": {
        "types": "./dist/esm/squircle/core.d.ts",
        "default": "./dist/esm/squircle/core.mjs"
      },
      "require": {
        "types": "./dist/cjs/squircle/core.d.cts",
        "default": "./dist/cjs/squircle/core.cjs"
      }
    }
  },
  "publishConfig": {
    "directory": "_release/package"
  },
  "files": [
    "README.md",
    "dist/",
    "**/package.json"
  ],
  "scripts": {
    "clean": "yarn g:clean",
    "build": "yarn g:build",
    "build:watch": "yarn g:build-watch",
    "test": "yarn g:test",
    "bench": "yarn run -T vitest bench",
    "test:watch": "yarn g:test-watch",
    "lint": "yarn g:lint",
    "fix": "yarn g:fix",
    "check": "yarn g:check"
  },
  "prettier": "prettier-config-custom",
  "dependencies": {
    "@emotion/hash": "catalog:",
    "@fastify/deepmerge": "catalog:",
    "@mincho-js/transform-to-vanilla": "workspace:^",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@mincho-js/debug-log": "workspace:^",
    "@types/node": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "eslint-config-custom": "workspace:^",
    "prettier-config-custom": "workspace:^",
    "tsconfig-custom": "workspace:^",
    "tslib": "catalog:",
    "vite": "catalog:",
    "vite-config-custom": "workspace:^",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@vanilla-extract/css": "*"
  }
}
