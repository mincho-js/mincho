{
  "extends": "tsconfig-custom/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@mincho-js/preset-theme-ui-react/jsx-runtime": ["./src/jsx-runtime.ts"],
      "@mincho-js/preset-theme-ui-react/jsx-dev-runtime": [
        "./src/jsx-dev-runtime.ts"
      ]
    },
    "tsBuildInfoFile": "./.cache/typescript/tsbuildinfo-esm",
    "outDir": "./dist/esm",
    "declarationDir": "./dist/esm",
    "jsx": "react-jsx",
    "jsxImportSource": "@mincho-js/preset-theme-ui-react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "_release"]
}
