{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mincho-js/preset-theme-ui-react",
  "version": "0.1.0",
  "description": "Theme UI component variants and scoped JSX authoring for Mincho React",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mincho-js/mincho.git",
    "directory": "packages/preset-theme-ui-react"
  },
  "homepage": "https://github.com/mincho-js/mincho/tree/main/packages/preset-theme-ui-react#readme",
  "typings": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/esm/config.d.ts",
        "default": "./dist/esm/config.mjs"
      },
      "require": {
        "types": "./dist/cjs/config.d.cts",
        "default": "./dist/cjs/config.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/esm/jsx-runtime.d.ts",
        "default": "./dist/esm/jsx-runtime.mjs"
      },
      "require": {
        "types": "./dist/cjs/jsx-runtime.d.cts",
        "default": "./dist/cjs/jsx-runtime.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/esm/jsx-dev-runtime.d.ts",
        "default": "./dist/esm/jsx-dev-runtime.mjs"
      },
      "require": {
        "types": "./dist/cjs/jsx-dev-runtime.d.cts",
        "default": "./dist/cjs/jsx-dev-runtime.cjs"
      }
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "NOTICE",
    "dist/",
    "**/package.json"
  ],
  "publishConfig": {
    "directory": "_release/package"
  },
  "scripts": {
    "clean": "yarn g:clean",
    "build": "yarn g:build",
    "build:watch": "yarn g:build-watch",
    "test": "yarn g:test",
    "test:watch": "yarn g:test-watch",
    "lint": "yarn g:lint",
    "fix": "yarn g:fix",
    "check": "yarn g:check"
  },
  "prettier": "prettier-config-custom",
  "dependencies": {
    "@mincho-js/css": "workspace:^",
    "@mincho-js/preset-theme-ui": "workspace:^"
  },
  "peerDependencies": {
    "@mincho-js/react": "workspace:^",
    "@vanilla-extract/css": "*",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@mincho-js/debug-log": "workspace:^",
    "@mincho-js/react": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/css": "catalog:",
    "eslint-config-custom": "workspace:^",
    "prettier-config-custom": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsconfig-custom": "workspace:^",
    "vite": "catalog:",
    "vite-config-custom": "workspace:^",
    "vitest": "catalog:"
  }
}
