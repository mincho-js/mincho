{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@mincho-js/react",
    "types": ["vitest/importMeta", "vite/client"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Path Aliases for Workspace Packages */
    "baseUrl": "../../",
    "paths": {
      "@examples/shared-component": ["examples/shared-component/src"],
      "@examples/shared-component/preset": ["examples/shared-component/src/preset.ts"],
      "@mincho-js/react": ["packages/react/src"],
      "@mincho-js/css": ["packages/css/src"],
      "@mincho-js/vite": ["packages/vite/src"]
    },

    "tsBuildInfoFile": "./.cache/typescript/tsbuildinfo-app"
  },
  "include": ["src"]
}
